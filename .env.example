# mock | openai | volcano
TRANSCRIPTION_PROVIDER=mock

# OpenAI provider
OPENAI_API_KEY=

# Volcano provider
# Account-level credentials. These are not sufficient by themselves for realtime speech recognition.
# Do not use leaked keys; rotate any key pasted into chat.
VOLCANO_ACCESS_KEY_ID=
VOLCANO_SECRET_ACCESS_KEY=

# Runtime ASR credentials from the Volcano speech product console.
# These are usually not the same thing as account-level AK/SK.
VOLCANO_ASR_API_KEY=
VOLCANO_ASR_APP_ID=
VOLCANO_ASR_TOKEN=
VOLCANO_ASR_CLUSTER=
# This account currently has the flash/Turbo resource only. Keep this safe,
# deployable default until the standard file ASR resource is authorized; then
# switch to standard_then_turbo + standard + a non-Turbo primary resource.
OWNMINUTES_ASR_FILE_STRATEGY=single
VOLCANO_ASR_MODE=flash
VOLCANO_ASR_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCANO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCANO_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCANO_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
OWNMINUTES_ASR_TURBO_FALLBACK_ENABLED=1
OWNMINUTES_ASR_TURBO_FALLBACK_MAX_AUDIO_MINUTES=30
VOLCANO_ASR_TURBO_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCANO_ASR_TURBO_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCANO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCANO_REALTIME_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
OWNMINUTES_REALTIME_ASR_PROTOCOL_IMPLEMENTED=1
OWNMINUTES_REALTIME_ASR_RUNTIME=stateful_node
OWNMINUTES_REALTIME_ASR_HEARTBEAT_POLICY=ping-15s-stale-45s
OWNMINUTES_REALTIME_ASR_RECONNECT_POLICY=fresh-session-bounded-no-audio-replay
OWNMINUTES_ASR_REAL_AUDIO_EVIDENCE=
OWNMINUTES_ASR_QUALITY_SAMPLING_POLICY=
OWNMINUTES_ASR_MEETING_BATCH_EVIDENCE_PATH=.data/acceptance/asr-meeting-batch-latest.json
OWNMINUTES_ASR_FALLBACK_POLICY=
OWNMINUTES_ASR_PRIVACY_POLICY=
# off (default) keeps loudness normalization only. mild opts into conservative
# speech-band filtering and stationary-noise reduction for controlled A/B runs.
OWNMINUTES_AUDIO_DENOISE_MODE=off

# Ark / Doubao summary provider
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=
OWNMINUTES_SUMMARY_JSON_ONLY=
OWNMINUTES_SUMMARY_HALLUCINATION_POLICY=
OWNMINUTES_SUMMARY_RETRY_POLICY=
OWNMINUTES_SUMMARY_HUMAN_REVIEW_POLICY=
OWNMINUTES_SUMMARY_MAX_ATTEMPTS=2
OWNMINUTES_SUMMARY_TIMEOUT_MS=30000
OWNMINUTES_SUMMARY_RETRY_DELAY_MS=300

# Durable finalization lease used to prevent duplicate model work across retries.
# A crashed worker can be retried after this lease expires.
OWNMINUTES_FINALIZATION_LEASE_MS=900000

# Shared server secret for encrypting tenant credentials. Use at least 32 random bytes,
# keep the same value across every App/Worker replica, and store it in a managed secret service.
OWNMINUTES_APP_SECRET=

# Production account repository and database. Require TLS for managed PostgreSQL.
OWNMINUTES_AUTH_REPOSITORY=local-file
# Development-only escape hatch. Production ignores this flag and public registration remains role=user.
OWNMINUTES_ALLOW_FIRST_USER_ADMIN=0
DATABASE_URL=

# Private S3-compatible meeting object storage. Never expose this bucket publicly.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
OWNMINUTES_STORAGE_PREFIX=ownminutes/meetings

# Full recording admission and resumable staging limits.
# Mobile recordings are uploaded in fixed 4 MiB parts. Keep the staged-byte budget
# at least as large as OWNMINUTES_FULL_AUDIO_MAX_BYTES.
OWNMINUTES_FULL_AUDIO_MAX_BYTES=268435456
OWNMINUTES_FULL_AUDIO_MAX_DURATION_MS=7200000
OWNMINUTES_FULL_AUDIO_MAX_PARALLEL=2
OWNMINUTES_AUDIO_CHUNK_MAX_BYTES=16777216
OWNMINUTES_RECORDING_UPLOAD_MAX_ACTIVE_PER_USER=4
OWNMINUTES_RECORDING_UPLOAD_MAX_STAGED_BYTES_PER_USER=268435456
OWNMINUTES_RECORDING_UPLOAD_STALE_HOURS=72

# inline for local development; postgres-queue for stateful production Node deployments.
# postgres-queue also requires OWNMINUTES_AUTH_REPOSITORY=postgres and DATABASE_URL/POSTGRES_URL.
OWNMINUTES_FINALIZATION_MODE=inline
OWNMINUTES_FINALIZATION_WORKER=0
OWNMINUTES_MEETING_DELETION_CLEANUP_WORKER=0
OWNMINUTES_MEETING_DELETION_CLEANUP_POLL_MS=2000
# Remote object-store calls are actively aborted on header, total-transfer, or idle-body timeout.
OWNMINUTES_OBJECT_STORE_HEADER_TIMEOUT_MS=2000
OWNMINUTES_OBJECT_STORE_SMALL_TRANSFER_TIMEOUT_MS=4000
OWNMINUTES_OBJECT_STORE_LARGE_TRANSFER_TIMEOUT_MS=900000
OWNMINUTES_OBJECT_STORE_IDLE_TIMEOUT_MS=30000
OWNMINUTES_FINALIZATION_POLL_MS=2000
OWNMINUTES_FINALIZATION_JOB_LEASE_MS=300000
OWNMINUTES_FINALIZATION_MAX_ATTEMPTS=5
OWNMINUTES_FINALIZATION_RETRY_BASE_MS=15000
OWNMINUTES_MEETING_WRITE_LOCK=auto
OWNMINUTES_MEETING_WRITE_LOCK_TIMEOUT_MS=15000
OWNMINUTES_POSTGRES_POOL_MAX=10
OWNMINUTES_POSTGRES_CONNECT_TIMEOUT_MS=10000
OWNMINUTES_POSTGRES_IDLE_TIMEOUT_MS=30000

# Mobile app public API base URL.
# Use your Mac LAN IP for iPhone testing, not localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3002

# Optional local Obsidian vault write target.
# Leave empty for hosted/public deployments. Local users can set this to a vault
# stored on the Mac itself or another explicitly chosen local folder.
OWNMINUTES_OBSIDIAN_VAULT_PATH=

# Development-only billing switch.
# Keep empty/0 in public or production environments so users cannot grant themselves paid plans.
OWNMINUTES_ENABLE_SIMULATED_BILLING=0

# Apple IAP / App Store Server API.
# Do not expose these values to clients. The iOS app sends transaction ids and a server-derived appAccountToken to StoreKit.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_BUNDLE_ID=
APPLE_IAP_ENVIRONMENT=sandbox
APPLE_IAP_PRODUCT_IDS=
# Apple Root Certificates can be PEM, base64 DER, JSON array, or file paths.
# Download Apple Root Certificates from https://www.apple.com/certificateauthority/
APPLE_ROOT_CERTIFICATES=
APPLE_ROOT_CERTIFICATE_PATHS=
APPLE_APP_APPLE_ID=
APPLE_IAP_ENABLE_ONLINE_CHECKS=0
OWNMINUTES_IAP_RECEIPT_VERIFICATION=
OWNMINUTES_IAP_ENTITLEMENT_MAPPING={"ownminutes.plus.monthly":{"plan":"plus","amountCents":799,"currency":"USD"},"ownminutes.pro.monthly":{"plan":"pro","amountCents":1999,"currency":"USD"}}
OWNMINUTES_IAP_REFUND_HANDLING=
OWNMINUTES_ORDER_IDEMPOTENCY=

# Email delivery for account verification and password reset.
# Local preview token exposure requires an explicit loopback-only test flag; production must keep it disabled.
RESEND_API_KEY=
OWNMINUTES_EMAIL_FROM=OwnMinutes <verify@notify.example.com>
OWNMINUTES_EMAIL_DOMAIN_VERIFIED=
OWNMINUTES_EMAIL_BOUNCE_POLICY=
OWNMINUTES_EMAIL_COMPLAINT_POLICY=
OWNMINUTES_REQUIRE_EMAIL_VERIFICATION=0
OWNMINUTES_ALLOW_LOCAL_AUTH_TOKEN_RESPONSE=0
