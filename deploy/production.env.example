# Copy through `npm run production:init -- --domain app.example.com --email ops@example.com --admin-email owner@example.com`.
# The generated deploy/.env.production and deploy/secrets/ are ignored by Git.
OWNMINUTES_DOMAIN=app.example.com
OWNMINUTES_TLS_EMAIL=ops@example.com
OWNMINUTES_RELEASE_ID=0000000000000000000000000000000000000000
OWNMINUTES_IMAGE=ownminutes:000000000000
OWNMINUTES_ADMIN_EMAIL=owner@example.com
OWNMINUTES_ADMIN_NAME=OwnMinutes Admin
OWNMINUTES_SUPPORT_EMAIL=support@example.com
OWNMINUTES_LEGAL_OPERATOR_NAME=
OWNMINUTES_LEGAL_OPERATOR_ADDRESS=
OWNMINUTES_LEGAL_OPERATOR_JURISDICTION=
# Shared-gateway deployments must attach only the gateway and OwnMinutes App to
# this dedicated external network. Never point it at a general project network.
OWNMINUTES_SHARED_PROXY_NETWORK=ownminutes_proxy

# Absolute paths are recommended on the deployment host.
OWNMINUTES_APP_SECRET_FILE=/srv/ownminutes/deploy/secrets/app-secret
# The isolated PostgreSQL cluster bootstrap, schema migrator, and runtime App
# use separate credentials. The bootstrap secret is never mounted into runtime.
OWNMINUTES_POSTGRES_PASSWORD_FILE=/srv/ownminutes/deploy/secrets/postgres-password
OWNMINUTES_POSTGRES_MIGRATOR_PASSWORD_FILE=/srv/ownminutes/deploy/secrets/postgres-migrator-password
OWNMINUTES_POSTGRES_APP_PASSWORD_FILE=/srv/ownminutes/deploy/secrets/postgres-app-password
OWNMINUTES_MINIO_ROOT_USER_FILE=/srv/ownminutes/deploy/secrets/minio-root-user
OWNMINUTES_MINIO_ROOT_PASSWORD_FILE=/srv/ownminutes/deploy/secrets/minio-root-password
OWNMINUTES_S3_ACCESS_KEY_ID_FILE=/srv/ownminutes/deploy/secrets/s3-access-key-id
OWNMINUTES_S3_SECRET_ACCESS_KEY_FILE=/srv/ownminutes/deploy/secrets/s3-secret-access-key
OWNMINUTES_S3_CLEANUP_ACCESS_KEY_ID_FILE=/srv/ownminutes/deploy/secrets/s3-cleanup-access-key-id
OWNMINUTES_S3_CLEANUP_SECRET_ACCESS_KEY_FILE=/srv/ownminutes/deploy/secrets/s3-cleanup-secret-access-key
OWNMINUTES_ADMIN_PASSWORD_FILE=/srv/ownminutes/deploy/secrets/admin-bootstrap-password
OWNMINUTES_BACKUP_ENCRYPTION_KEY_FILE=/srv/ownminutes/deploy/secrets/backup-encryption-key

# Prefer Docker file secrets for global provider credentials. `/dev/null`
# preserves compatibility while a provider is intentionally unconfigured.
OWNMINUTES_VOLCANO_ASR_API_KEY_FILE=/dev/null
OWNMINUTES_VOLCANO_ASR_TOKEN_FILE=/dev/null
OWNMINUTES_ARK_API_KEY_FILE=/dev/null
OWNMINUTES_RESEND_API_KEY_FILE=/dev/null

# Apple IAP files stay outside Git. The .p8 is private; Apple root certificates are public
# trust anchors but are mounted read-only through the same file-secret boundary.
OWNMINUTES_APPLE_PRIVATE_KEY_FILE=/srv/ownminutes/deploy/secrets/apple-iap-private-key.p8
OWNMINUTES_APPLE_ROOT_CA_G2_FILE=/srv/ownminutes/deploy/secrets/AppleRootCA-G2.cer
OWNMINUTES_APPLE_ROOT_CA_G3_FILE=/srv/ownminutes/deploy/secrets/AppleRootCA-G3.cer

# Apple IAP runtime configuration. Keep evidence fields empty until the matching
# Sandbox/TestFlight scenario has actually passed and a private redacted record exists.
APPLE_ISSUER_ID=
APPLE_KEY_ID=
APPLE_BUNDLE_ID=app.ownminutes.mobile
OWNMINUTES_APP_SECRET_VERSION=v1
APPLE_APP_APPLE_ID=6790795844
APPLE_IAP_ENVIRONMENT=production
APPLE_IAP_PRODUCT_IDS=ownminutes.plus.monthly,ownminutes.pro.monthly
APPLE_IAP_ENABLE_ONLINE_CHECKS=0
APPLE_IAP_FETCH_TIMEOUT_MS=10000
# Public endpoint for the current deployment. In App Store Connect, the shared TestFlight
# staging value belongs in Sandbox Server URL only; do not copy it into Production Server URL.
OWNMINUTES_IAP_NOTIFICATION_URL=https://app.example.com/api/payments/apple/notifications
OWNMINUTES_IAP_RECEIPT_VERIFICATION=
OWNMINUTES_IAP_ENTITLEMENT_MAPPING={"ownminutes.plus.monthly":{"plan":"plus","amountCents":799,"currency":"USD"},"ownminutes.pro.monthly":{"plan":"pro","amountCents":1999,"currency":"USD"}}
OWNMINUTES_IAP_REFUND_HANDLING=
OWNMINUTES_ORDER_IDEMPOTENCY=
OWNMINUTES_IAP_SANDBOX_PURCHASE_PROOF=
OWNMINUTES_IAP_SANDBOX_RENEWAL_PROOF=
OWNMINUTES_IAP_SANDBOX_REFUND_PROOF=
OWNMINUTES_IAP_SANDBOX_EXPIRATION_PROOF=
OWNMINUTES_IAP_DB_LEDGER_PROOF=
OWNMINUTES_IAP_SANDBOX_ACCEPTANCE=0

# Optional production BYOK encryption. Leave OWNMINUTES_SECRET_STORE empty for local/staging only.
# When set to vault-transit, production-stack.mjs automatically adds deploy/compose.vault.yml.
OWNMINUTES_SECRET_STORE=
OWNMINUTES_VAULT_ADDR=https://vault.example.com
OWNMINUTES_VAULT_TRANSIT_KEY=ownminutes-provider-secrets
OWNMINUTES_VAULT_TRANSIT_MOUNT=transit
OWNMINUTES_VAULT_NAMESPACE=
OWNMINUTES_VAULT_TOKEN_FILE=/srv/ownminutes/deploy/secrets/vault-token
OWNMINUTES_SECRET_ROTATION_POLICY=
OWNMINUTES_SECRET_AUDIT_LOG=/app/.data/auth/secret-audit.jsonl
OWNMINUTES_SECRET_AUDIT_EXTERNAL_ROTATION=1
OWNMINUTES_SECRET_AUDIT_MAX_BYTES=104857600
OWNMINUTES_SECRET_AUDIT_ROTATION_INTERVAL_SECONDS=300
OWNMINUTES_SECRET_AUDIT_ROTATE_BYTES=52428800
OWNMINUTES_SECRET_AUDIT_RETENTION_DAYS=180
OWNMINUTES_TENANT_SCOPED_KEYS=
OWNMINUTES_SECRET_DELETION_PROOF=
OWNMINUTES_SECRET_ADMIN_ACCESS_POLICY=
OWNMINUTES_SECRET_LOCAL_SECRET_DECISION=
OWNMINUTES_SECRET_DECRYPT_FAILURE_AUDIT=
OWNMINUTES_SECRET_BACKUP_RECOVERY_POLICY=

# Encrypted local backup artifacts. Replicate these to an independent off-host destination.
OWNMINUTES_BACKUP_DIR=/srv/ownminutes/backups
OWNMINUTES_BACKUP_RETENTION_COUNT=7
OWNMINUTES_BACKUP_MAX_AGE_HOURS=26
OWNMINUTES_BACKUP_OFFSITE_MAX_AGE_HOURS=26
OWNMINUTES_BACKUP_OFFSITE_RETENTION_DAYS=35
OWNMINUTES_BACKUP_RESTORE_MAX_AGE_DAYS=35

# Independent S3-compatible destination. Credentials must not be the application
# bucket credentials and need ListBucket/GetObject/PutObject/DeleteObject only
# within OWNMINUTES_BACKUP_OFFSITE_PREFIX.
OWNMINUTES_BACKUP_OFFSITE_ENDPOINT=https://s3.example.com
OWNMINUTES_BACKUP_OFFSITE_BUCKET=ownminutes-offsite
OWNMINUTES_BACKUP_OFFSITE_PREFIX=ownminutes/backups
OWNMINUTES_BACKUP_OFFSITE_ACCESS_KEY_FILE=/srv/ownminutes/deploy/secrets/offsite-backup-access-key
OWNMINUTES_BACKUP_OFFSITE_SECRET_KEY_FILE=/srv/ownminutes/deploy/secrets/offsite-backup-secret-key

# Canonical current meeting objects do not expire. Retain only noncurrent
# versions and delete markers for bounded recovery. The cleanup service only
# targets nested transient ASR copies and incomplete resumable uploads.
OWNMINUTES_NONCURRENT_RETENTION_DAYS=7
OWNMINUTES_TRANSIENT_RETENTION_DAYS=7
OWNMINUTES_UPLOAD_RETENTION_DAYS=2
OWNMINUTES_TRANSIENT_CLEANUP_INTERVAL_SECONDS=21600

# Optional server-side default providers. Credentials are accepted only through
# the owner-only files configured above; plaintext provider environment values
# are intentionally unsupported in production. BYOK users can configure their
# own credentials in the app.
TRANSCRIPTION_PROVIDER=volcano
VOLCANO_ASR_APP_ID=
VOLCANO_ASR_CLUSTER=
# Keep single/flash until this production account is authorized for the
# standard file ASR resource. Only then switch to standard_then_turbo.
OWNMINUTES_ASR_FILE_STRATEGY=single
VOLCANO_ASR_MODE=flash
VOLCANO_ASR_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCANO_ASR_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCANO_ASR_SUBMIT_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/submit
VOLCANO_ASR_QUERY_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/query
OWNMINUTES_ASR_TURBO_FALLBACK_ENABLED=1
OWNMINUTES_ASR_TURBO_FALLBACK_MAX_AUDIO_MINUTES=30
VOLCANO_ASR_TURBO_RECOGNIZE_URL=https://openspeech.bytedance.com/api/v3/auc/bigmodel/recognize/flash
VOLCANO_ASR_TURBO_RESOURCE_ID=volc.bigasr.auc_turbo
VOLCANO_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
VOLCANO_REALTIME_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
OWNMINUTES_ASR_REAL_AUDIO_EVIDENCE=
OWNMINUTES_ASR_QUALITY_SAMPLING_POLICY=
OWNMINUTES_ASR_FALLBACK_POLICY=
OWNMINUTES_ASR_PRIVACY_POLICY=
OWNMINUTES_REALTIME_ASR_PROTOCOL_IMPLEMENTED=1
OWNMINUTES_REALTIME_ASR_RUNTIME=stateful_node
OWNMINUTES_REALTIME_ASR_HEARTBEAT_POLICY=ping-15s-stale-45s
OWNMINUTES_REALTIME_ASR_RECONNECT_POLICY=fresh-session-bounded-no-audio-replay
OWNMINUTES_REALTIME_ASR_WEAK_NETWORK_EVIDENCE=
OWNMINUTES_REALTIME_ASR_FAILURE_ISOLATION_EVIDENCE=
OWNMINUTES_REALTIME_ASR_REAL_MEETING_EVIDENCE=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_CHAT_MODEL=
OWNMINUTES_SUMMARY_JSON_ONLY=
OWNMINUTES_SUMMARY_HALLUCINATION_POLICY=
OWNMINUTES_SUMMARY_RETRY_POLICY=
OWNMINUTES_SUMMARY_HUMAN_REVIEW_POLICY=

# Account verification and password reset email. Public registration stays unavailable until configured.
OWNMINUTES_EMAIL_FROM="OwnMinutes <verify@notify.example.com>"
OWNMINUTES_EMAIL_DOMAIN_VERIFIED=
OWNMINUTES_EMAIL_BOUNCE_POLICY=
OWNMINUTES_EMAIL_COMPLAINT_POLICY=
OWNMINUTES_REQUIRE_EMAIL_VERIFICATION=1
